# BlobVision V1

# Python
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# Downloaded weights (install on first launch via in-app buttons or app/scripts/)
models/*
!models/README.txt
models/hf_cache/

# Generated outputs
outputs/*
!outputs/.gitkeep

# Bundled video tools (run Setup Video Codecs.bat once)
video-codecs/ffmpeg/
video-codecs/rife/
!video-codecs/README.txt

# Legacy app-local caches (migrated to models/ on first run)
app/checkpoints/
app/outputs/
app/style-transfer/weights/
app/style-transfer/samples/
taming-transformers/

# Safety net — never commit weights
*.ckpt
*.safetensors
*.pth

# Local logs
*.log

# OS / editor
Thumbs.db
.DS_Store
.vscode/
.idea/
.cursor/
.claude/

# Tauri shell (tauri/) — npm/cargo build artifacts, not source
tauri/node_modules/
tauri/dist/
tauri/src-tauri/target/
tauri/src-tauri/gen/
